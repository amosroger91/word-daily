{
  "name": "word-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-click daily Bible verse videos in The Word's style: narrated, word-highlighted, with B-roll and music.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:render": "node scripts/smoke-render.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "^1.0.10",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "supertest": "^7.3.1",
    "vite": "^8.3.4"
  }
}
